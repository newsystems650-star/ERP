# Usamos una base ligera de Unix optimizada para compilaciones de bajo nivel
FROM debian:bookworm-slim


# Instalar dependencias del sistema, compiladores de C, libusb y Python para Pandas
RUN apt-get update && apt-get install -y \
    build-essential \
    libusb-1.0-0-dev \
    libssl-dev \
    python3 \
    python3-pip \
    python3-pandas \
    coreutils \
    && rm -rf /var/lib/apt/lists/*


WORKDIR /app


# Copiar el código fuente del motor, protocolo y scripts
COPY . .


# Compilar el motor criptográfico binario nativo dentro del contenedor
RUN gcc crypto_module.c -o /app/crypto_module -lcrypto


# Exponer el directorio donde se creará el socket de sincronización binaria
VOLUME ["/tmp"]


# Comando de arranque: Inicia tu orquestador/motor binario
CMD ["/app/crypto_module"]